<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/surface_variant"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/motionImage"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:background="@color/gray_light"
        android:contentDescription="Motion capture" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/motionTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/motionCameraId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera ID"
            android:textSize="12sp"
            android:textColor="@color/gray_dark" />
    </LinearLayout>

    <ImageView
        android:src="@drawable/ic_motion_alert"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="Motion alert" />
</LinearLayout>